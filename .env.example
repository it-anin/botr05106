# ก๊อปไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้)

# ── ProMaxx (ฝั่ง export) ──
PROMAXX_USER_CODE=000
PROMAXX_PASSWORD=changeme

# ── Supabase (ฝั่ง upload-products.mjs) ──
# เอา key จาก Supabase Dashboard → Settings → API → service_role
# ⚠️ service_role bypass RLS ทั้งหมด ห้าม commit ห้ามแชร์ผ่านช่องทางไม่ปลอดภัย
SUPABASE_SERVICE_KEY=
